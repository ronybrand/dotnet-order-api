{
  "Logging": {
    "Console": { "FormatterName": "simple", "FormatterOptions": { "IncludeScopes": true, "SingleLine": true, "TimestampFormat": "yyyy-MM-ddTHH:mm:ssZ ", "UseUtcTimestamp": true } },
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore.Database.Command": "Warning" }
  },
  "AllowedHosts": "*",
  "Cors": { "AllowedOrigins": "" },
  "Jwt": { "Audience": "dotnet-order-api", "Issuer": "dotnet-order-api" },
  "RabbitMq": { "Host": "localhost", "Port": 5672, "VirtualHost": "/" },
  "Database": { "MigrateOnStartup": false }
}
